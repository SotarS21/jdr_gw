{{!-- <div>, pas <form> : DocumentSheetV2 rend déjà this.element comme un <form>
      (classes déjà appliquées) — un <form> imbriqué casserait FormDataExtended.
      Un seul élément racine reste requis (PARTS). --}}
<div class="galactic-wars-body">
  <header class="sheet-header">
    <img class="portrait" src="{{system.portrait}}" data-action="editImage" alt="{{actor.name}}">
    <div class="header-fields">
      <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'GALACTICWARS.Sheet.Nom'}}">
      <label>{{localize 'GALACTICWARS.Sheet.Prenom'}} <input type="text" name="system.infos.prenom" value="{{system.infos.prenom}}"></label>
      <div class="race-metier-row">
        <span>{{localize 'GALACTICWARS.Sheet.Race'}} : {{system.race.nom}}</span>
        <button type="button" data-action="applyRace">{{localize 'GALACTICWARS.Sheet.Choisir'}}</button>
        <span>{{localize 'GALACTICWARS.Sheet.Metier'}} : {{system.metier.nom}}</span>
        <button type="button" data-action="applyMetier">{{localize 'GALACTICWARS.Sheet.Choisir'}}</button>
      </div>
      {{#if system.metier.description}}
      <p class="metier-description">{{system.metier.description}}</p>
      {{/if}}
    </div>
  </header>

  <div class="sheet-body">
  <section class="pv-rapide">
    <h2>{{localize 'GALACTICWARS.Sheet.PV'}}</h2>
    <label>{{localize 'GALACTICWARS.Inconscient.Actuels'}} <input type="number" name="system.pv.value" value="{{system.pv.value}}" min="0"></label>
    <label>{{localize 'GALACTICWARS.Inconscient.Max'}} <input type="number" name="system.pv.max" value="{{system.pv.max}}" min="0"></label>
    {{#if (eq system.pv.value 0)}}<span class="etat-inconscient"><i class="fa-solid fa-bed"></i> {{localize 'GALACTICWARS.Inconscient.Etat'}}</span>{{/if}}
  </section>

  <section class="talent">
    <h2>{{localize 'GALACTICWARS.Sheet.Talent'}}</h2>
    <label>{{localize 'GALACTICWARS.Sheet.Nom'}} <input type="text" name="system.talent.nom" value="{{system.talent.nom}}"></label>
    <textarea name="system.talent.description" placeholder="{{localize 'GALACTICWARS.Sheet.TalentDescriptionPlaceholder'}}">{{system.talent.description}}</textarea>
  </section>

  <section class="caracteristiques-rapides">
    <h2>{{localize 'GALACTICWARS.Sheet.Caracteristiques'}}
      {{#unless estPnj}}({{system.totalCaracteristiques}} / {{limites.totalMax}}{{#if system.depasseLimiteTotale}} ⚠{{/if}}){{/unless}}
    </h2>
    {{#unless estPnj}}
    <p class="hint">{{localize 'GALACTICWARS.Sheet.LimitePlafondHint'}}{{#if system.depasseLimitePlafond}} ⚠{{/if}}</p>
    {{/unless}}
    <ul class="caracteristiques-rapides-list">
      {{#each caracteristiques as |car|}}
      <li>
        <button type="button" data-action="rollCaracteristique" data-cle="{{car.cle}}">🎲</button>
        <label>{{localize car.label}}</label>
        <input type="number" name="system.caracteristiques.{{car.cle}}" value="{{car.valeur}}">
        {{#if car.bonus}}<span class="bonus-effet mono{{#if (lt car.bonus 0)}} malus{{/if}}" data-tooltip="{{localize 'GALACTICWARS.Effets.BonusCaracteristique' total=car.total}}<br>{{car.sources}}">{{#if (gt car.bonus 0)}}+{{/if}}{{car.bonus}}</span>{{/if}}
      </li>
      {{/each}}
    </ul>
  </section>

  <section class="survie">
    <h2>{{localize 'GALACTICWARS.Sheet.Survie'}}
      <button type="button" data-action="rollSurvie">🎲</button>
    </h2>
    <label>{{localize 'GALACTICWARS.Sheet.Base'}} <input type="number" name="system.survie.base" value="{{system.survie.base}}"></label>
    <label>{{localize 'GALACTICWARS.Sheet.Racial'}} <input type="number" name="system.survie.racial" value="{{system.survie.racial}}"></label>
    <span class="total">{{system.survie.total}}%</span>
    <label>{{localize 'GALACTICWARS.Sheet.Credits'}} <input type="number" name="system.credits" value="{{system.credits}}" min="0"></label>
  </section>

  <section class="traits-rapides">
    <h2>{{localize 'GALACTICWARS.Traits.Titre'}}
      {{#if editable}}<button type="button" data-action="ajouterTrait" data-tooltip="{{localize 'GALACTICWARS.Traits.Ajouter'}}" aria-label="{{localize 'GALACTICWARS.Traits.Ajouter'}}">+</button>{{/if}}
    </h2>
    {{#each traits as |trait|}}
    <div class="trait-rapide" data-item-id="{{trait.id}}">
      <a class="trait-nom" data-action="ouvrirTrait"><img src="{{trait.img}}" alt=""> {{trait.name}}</a>
      {{#if trait.activable}}<button type="button" class="trait-actif-btn{{#if trait.enCours}} actif{{/if}}" data-action="basculerTraitActif" {{#unless @root.editable}}disabled{{/unless}} data-tooltip="{{#if trait.enCours}}{{localize 'GALACTICWARS.Traits.Desactiver'}}{{else}}{{localize 'GALACTICWARS.Traits.Activer'}}{{/if}}" aria-pressed="{{#if trait.enCours}}true{{else}}false{{/if}}"><i class="fa-solid fa-power-off"></i> {{#if trait.enCours}}{{localize 'GALACTICWARS.Traits.EnCours'}}{{else}}{{localize 'GALACTICWARS.Traits.Actif'}}{{/if}}</button>{{/if}}
      {{#if trait.autreFiche}}<span class="hint" data-tooltip="{{localize 'GALACTICWARS.Traits.AutreFiche'}}"><i class="fa-solid fa-triangle-exclamation"></i> {{localize 'GALACTICWARS.Traits.Fiche.Classique'}}</span>
      {{else if trait.effets}}<span class="trait-effets mono">{{trait.effets}}</span>{{else if trait.effetsPossibles}}<span class="trait-effets mono">{{#if trait.effetsPossibles}}<span class="trait-effets-possibles">{{trait.effetsPossibles}}</span>{{/if}}</span>{{/if}}
      {{#if @root.editable}}<button type="button" class="del-btn" data-action="supprimerTrait" data-tooltip="{{localize 'GALACTICWARS.Traits.Retirer'}}" aria-label="{{localize 'GALACTICWARS.Traits.Retirer'}}">🗑</button>{{/if}}
      {{#if trait.system.avantage}}<p class="trait-detail">{{trait.system.avantage}}{{#if trait.system.inconvenient}} — {{trait.system.inconvenient}}{{/if}}</p>{{/if}}
    </div>
    {{else}}
    <p class="hint">{{localize 'GALACTICWARS.Traits.Aucun'}}</p>
    {{/each}}
    <p class="reduction-rapide"><i class="fa-solid fa-shield-halved"></i> {{localize 'GALACTICWARS.Combat.Protection'}} : <span class="mono">{{reduction.total}}</span></p>
    <div class="gw-couverts">
          <span class="gw-couverts-titre"><i class="fa-solid fa-person-shelter"></i> {{localize 'GALACTICWARS.Couvert.Titre'}}{{#if reduction.temporaire}} <span class="mono">+{{reduction.temporaire}}</span>{{/if}}</span>
          {{#each couverts as |c|}}<button type="button" class="gw-couvert{{#if c.actif}} actif{{/if}}" data-action="basculerCouvert" data-couvert="{{c.cle}}" aria-pressed="{{#if c.actif}}true{{else}}false{{/if}}" data-tooltip="{{localize 'GALACTICWARS.Couvert.Hint' armure=c.armure}}"{{#unless @root.editable}} disabled{{/unless}}>{{localize c.label}} <span class="mono">+{{c.armure}}</span></button>{{/each}}
        </div>
  </section>

  <section class="equipement">
    <h2>{{localize 'GALACTICWARS.Sheet.Equipement'}}</h2>
    <textarea name="system.equipement">{{system.equipement}}</textarea>
  </section>

  <section class="description">
    <h2>{{localize 'GALACTICWARS.Sheet.Biographie'}}</h2>
    <prose-mirror name="system.description" value="{{system.description}}">{{{descriptionEnrichie}}}</prose-mirror>
  </section>
  </div>
</div>
