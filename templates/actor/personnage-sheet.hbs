{{!-- <div>, pas <form> : DocumentSheetV2 rend déjà this.element comme un <form>
      (classes déjà appliquées) — un <form> imbriqué ici ferait porter tous les
      inputs par ce <form> interne plutôt que par le vrai, et FormDataExtended
      (this.element) ne verrait plus aucun champ (voir JOURNAL.md, bug de
      sauvegarde des fiches). Un seul élément racine reste requis (PARTS). --}}
<div class="galactic-wars-body">
  <header class="sheet-header">
    <div class="portrait-frame">
      <img class="portrait" src="{{system.portrait}}" data-action="editImage" alt="{{actor.name}}">
    </div>
    <div class="header-fields">
      <div class="nom-row">
        <button type="button" class="btn btn-edition {{#if modeEdition}}active{{/if}}" data-action="basculerEdition"
                data-tooltip="{{localize 'GALACTICWARS.Sheet.ModeEditionHint'}}" aria-pressed="{{#if modeEdition}}true{{else}}false{{/if}}">
          <i class="fa-solid {{#if modeEdition}}fa-lock-open{{else}}fa-lock{{/if}}"></i>
          {{localize 'GALACTICWARS.Sheet.ModeEdition'}}
        </button>
        <input type="text" class="nom-input mono" name="name" value="{{actor.name}}" placeholder="{{localize 'GALACTICWARS.Sheet.Nom'}}">
      </div>
      <div class="race-metier-row">
        <span class="champ"><span class="eyebrow">{{localize 'GALACTICWARS.Sheet.Race'}}</span> <span class="valeur-texte">{{system.race.nom}}</span></span>
        {{#if modeEdition}}<button type="button" class="btn" data-action="applyRace">{{localize 'GALACTICWARS.Sheet.Choisir'}}</button>{{/if}}
        <span class="champ"><span class="eyebrow">{{localize 'GALACTICWARS.Sheet.Metier'}}</span> <span class="valeur-texte">{{system.metier.nom}}</span></span>
        {{#if modeEdition}}<button type="button" class="btn" data-action="applyMetier">{{localize 'GALACTICWARS.Sheet.Choisir'}}</button>{{/if}}
      </div>
      <div class="niveau-row">
        <span class="eyebrow">{{localize 'GALACTICWARS.Sheet.Niveau'}}</span>
        <input type="number" class="mono niveau-input" name="system.niveau" value="{{system.niveau}}">
      </div>
    </div>
    {{!-- PV / Force / Crédits dans l'en-tête : accessibles quel que soit l'onglet. (Stress retiré
         en attendant un système d'états actifs — system.stress reste dans le schéma.) --}}
    <div class="header-ressources stat-grid">
      <div class="stat-card stat-pv">
        <span class="eyebrow">{{localize 'GALACTICWARS.Sheet.PV'}}
          <button type="button" class="btn-repos" data-action="repos" data-tooltip="{{localize 'GALACTICWARS.Sheet.ReposHint'}}"><i class="fa-solid fa-bed"></i></button>
        </span>
        <div class="stat-value">
          <input type="number" class="mono" name="system.pv.value" value="{{system.pv.value}}">
          <span class="sep">/</span>
          <input type="number" class="mono max" name="system.pv.max" value="{{system.pv.max}}">
        </div>
        <div class="barre-pv {{barrePV.etat}}" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{barrePV.pourcentage}}"
             data-tooltip="{{barrePV.pourcentage}} %">
          <span class="remplissage" style="width: {{barrePV.pourcentage}}%"></span>
        </div>
      </div>
      <div class="stat-card stat-force">
        <span class="eyebrow">{{localize 'GALACTICWARS.Sheet.PointsDeForce'}}</span>
        {{!-- Ressource dépensable, pas une jauge valeur/max : seule .value est utilisée. --}}
        <div class="stat-value">
          <input type="number" class="mono" name="system.pointsDeForce.value" value="{{system.pointsDeForce.value}}" min="0">
        </div>
      </div>
      <div class="stat-card stat-credits">
        <span class="eyebrow">{{localize 'GALACTICWARS.Sheet.Credits'}}</span>
        <input type="number" class="mono" name="system.credits" value="{{system.credits}}" min="0">
      </div>
    </div>
  </header>

  <nav class="onglets">
    <button type="button" class="onglet-btn {{#if (eq ongletActif 'personnage')}}active{{/if}}" data-action="changerOnglet" data-onglet="personnage">{{localize 'GALACTICWARS.Sheet.OngletPersonnage'}}</button>
    <button type="button" class="onglet-btn {{#if (eq ongletActif 'equipements')}}active{{/if}}" data-action="changerOnglet" data-onglet="equipements">{{localize 'GALACTICWARS.Sheet.OngletEquipements'}}</button>
    <button type="button" class="onglet-btn {{#if (eq ongletActif 'informations')}}active{{/if}}" data-action="changerOnglet" data-onglet="informations">{{localize 'GALACTICWARS.Sheet.OngletInformations'}}</button>
  </nav>

  <div class="sheet-body">
  {{#if (eq ongletActif 'personnage')}}
  <section class="ressources">
    <h2 class="eyebrow">{{localize 'GALACTICWARS.Sheet.Ressources'}}</h2>
    <div class="stat-grid">
      <div class="stat-card stat-alignement">
        <span class="eyebrow">{{localize 'GALACTICWARS.Alignement.Titre'}}</span>
        <div class="pool pool-lumiere">
          <button type="button" class="pip-btn" data-action="ajusterLumiere" data-delta="-1">-</button>
          <span class="pips">
            {{#each pipsLumiere as |rempli|}}<span class="dot {{#if rempli}}dot-lumiere{{else}}dot-vide{{/if}}"></span>{{/each}}
          </span>
          <span class="mono valeur">{{system.lumiere}}</span>
          <button type="button" class="pip-btn" data-action="ajusterLumiere" data-delta="1">+</button>
        </div>
        <div class="pool pool-obscurite">
          <button type="button" class="pip-btn" data-action="ajusterObscurite" data-delta="-1">-</button>
          <span class="pips">
            {{#each pipsObscurite as |rempli|}}<span class="dot {{#if rempli}}dot-obscurite{{else}}dot-vide{{/if}}"></span>{{/each}}
          </span>
          <span class="mono valeur">{{system.obscurite}}</span>
          <button type="button" class="pip-btn" data-action="ajusterObscurite" data-delta="1">+</button>
        </div>
        <div class="bonus-choix">
          <label><input type="radio" name="bonusAlignement" value="aucun" checked> {{localize 'GALACTICWARS.Alignement.Aucun'}}</label>
          <label{{#unless system.lumiere}} class="disabled"{{/unless}}>
            <input type="radio" name="bonusAlignement" value="lumiere" {{#unless system.lumiere}}disabled{{/unless}}> {{localize 'GALACTICWARS.Alignement.Lumiere'}} (+15%)
          </label>
          <label{{#unless system.obscurite}} class="disabled"{{/unless}}>
            <input type="radio" name="bonusAlignement" value="obscurite" {{#unless system.obscurite}}disabled{{/unless}}> {{localize 'GALACTICWARS.Alignement.Obscurite'}} (+15%)
          </label>
        </div>
        <p class="hint">{{localize 'GALACTICWARS.Alignement.Hint'}}</p>
      </div>
    </div>
  </section>

  <section class="caracteristiques">
    <div class="section-header">
      <h2 class="eyebrow">{{localize 'GALACTICWARS.Sheet.Caracteristiques'}} &amp; {{localize 'GALACTICWARS.Sheet.Competences'}}</h2>
      <div class="legende">
        <span class="legende-item"><span class="dot dot-metier"></span>{{localize 'GALACTICWARS.Sheet.CompetenceMetierHint'}}</span>
        <span class="legende-item"><span class="dot dot-force"></span>{{localize 'GALACTICWARS.Sheet.CompetenceLieeForce'}}</span>
      </div>
    </div>
    {{#if modeEdition}}
    <div class="points-caracteristiques {{pointsCaracteristiques.etat}}" data-tooltip="{{localize 'GALACTICWARS.Sheet.PointsCaracteristiquesHint'}}">
      <span class="eyebrow">{{localize 'GALACTICWARS.Sheet.PointsCaracteristiques'}}</span>
      <span class="mono valeur">{{pointsCaracteristiques.valeur}} / {{pointsCaracteristiques.attendu}}</span>
      {{#if (eq pointsCaracteristiques.etat 'manque')}}<span class="etat">{{localize 'GALACTICWARS.Sheet.PointsCaracteristiquesManque'}}</span>{{/if}}
      {{#if (eq pointsCaracteristiques.etat 'exces')}}<span class="etat">{{localize 'GALACTICWARS.Sheet.PointsCaracteristiquesExces'}}</span>{{/if}}
    </div>
    {{/if}}
    <div class="caracteristiques-grid">
      {{#each caracteristiques as |car|}}
      <div class="colonne-caracteristique car-{{car.cle}}">
        <div class="caracteristique">
          <label>{{localize car.label}}</label>
          <span class="total mono" data-tooltip="{{localize 'GALACTICWARS.Sheet.Total'}}">{{car.total}}</span>
          <div class="detail-caracteristique">
            {{!-- Hors mode édition, pas d'input : la base n'est pas soumise, donc pas modifiée
                  (SchemaField, un champ absent du formulaire est simplement ignoré). --}}
            {{#if @root.modeEdition}}
            <input type="number" name="system.caracteristiques.{{car.cle}}.base" value="{{car.base}}" data-tooltip="{{localize 'GALACTICWARS.Sheet.ValeurInput'}}">
            {{else}}
            <span class="base-lecture mono" data-tooltip="{{localize 'GALACTICWARS.Sheet.ValeurInput'}}">{{car.base}}</span>
            {{/if}}
            <span class="racial mono" data-tooltip="{{localize 'GALACTICWARS.Sheet.BonusRacial'}}">{{#if car.racial}}{{#if (gt car.racial 0)}}+{{/if}}{{car.racial}}{{else}}+0{{/if}}</span>
          </div>
        </div>
        <ul class="competences-list {{#unless @root.modeEdition}}lecture{{/unless}}">
          <li class="skill-row competences-entete" aria-hidden="true">
            <span class="entete-nom">{{localize 'GALACTICWARS.Sheet.Nom'}}</span>
            <span>{{localize 'GALACTICWARS.Sheet.NiveauCourt'}}</span>
            {{#if @root.modeEdition}}<span>{{localize 'GALACTICWARS.Sheet.AjustementCourt'}}</span>{{/if}}
            <span>{{localize 'GALACTICWARS.Sheet.Total'}}</span>
          </li>
          {{#each car.competences as |cpt|}}
          <li class="competence-row skill-row {{#if cpt.estCompetenceForce}}force{{/if}} {{#if cpt.estReservee}}reservee{{/if}} {{#if cpt.bloquee}}bloquee{{/if}} {{#if cpt.acquiseParMetier}}acquise{{/if}}"
              data-index="{{cpt.index}}"
              {{#if cpt.bloquee}}data-tooltip="{{#if @root.isGM}}{{localize 'GALACTICWARS.Sheet.CompetenceBloqueeMJ'}}{{else}}{{localize 'GALACTICWARS.Sheet.CompetenceBloquee'}}{{/if}}"{{/if}}>
            <span class="label" data-cle="{{cpt.cle}}" {{#unless cpt.bloquee}}data-action="rollCompetence" role="button"{{/unless}}>{{#if cpt.recommandee}}<span class="dot dot-metier"></span>{{/if}}{{#if cpt.estCompetenceForce}}<span class="dot dot-force"></span>{{/if}}{{localize cpt.label}}{{#if cpt.bloquee}} <i class="fa-solid fa-lock cadenas"></i>{{/if}}</span>
            {{!-- system.competences est un ArrayField : Document#update() remplace chaque élément
                  entier plutôt que de fusionner ses champs un par un. TOUT champ d'une compétence
                  doit donc être soumis à chaque sauvegarde, même quand il n'est pas modifiable
                  (hors mode édition, compétence bloquée) — sinon il serait réinitialisé à sa
                  valeur par défaut du schéma (cle: "" notamment, ce qui casse GW.competences[cle]
                  partout ; niveau/ajustement remis à 0). --}}
            <input type="hidden" name="system.competences.{{cpt.index}}.cle" value="{{cpt.cle}}">
            <input type="hidden" name="system.competences.{{cpt.index}}.racial" value="{{cpt.racial}}" data-dtype="Number">
            <input type="hidden" name="system.competences.{{cpt.index}}.metier" value="{{cpt.metier}}" data-dtype="Number">
            <input type="hidden" name="system.competences.{{cpt.index}}.acquiseParMetier" value="{{cpt.acquiseParMetier}}" data-dtype="Boolean">
            <input type="hidden" name="system.competences.{{cpt.index}}.recommandee" value="{{cpt.recommandee}}" data-dtype="Boolean">
            <input type="hidden" name="system.competences.{{cpt.index}}.debloquee" value="{{cpt.debloquee}}" data-dtype="Boolean">
            {{#if (and @root.modeEdition (not cpt.bloquee))}}
            <input type="number" class="niveau mono" name="system.competences.{{cpt.index}}.niveau" value="{{cpt.niveau}}" min="0" max="3" data-tooltip="{{localize 'GALACTICWARS.Sheet.Niveau'}}">
            {{else}}
            <input type="hidden" name="system.competences.{{cpt.index}}.niveau" value="{{cpt.niveau}}" data-dtype="Number">
            <span class="niveau niveau-lecture mono" data-tooltip="{{localize 'GALACTICWARS.Sheet.Niveau'}}">{{#if cpt.bloquee}}0{{else}}{{cpt.niveau}}{{/if}}</span>
            {{/if}}
            {{#if @root.modeEdition}}
            <input type="number" class="ajustement mono" name="system.competences.{{cpt.index}}.ajustement" value="{{cpt.ajustement}}" data-tooltip="{{localize 'GALACTICWARS.Sheet.AjustementManuelHint'}}">
            {{else}}
            <input type="hidden" name="system.competences.{{cpt.index}}.ajustement" value="{{cpt.ajustement}}" data-dtype="Number">
            {{/if}}
            <span class="total mono" data-tooltip="{{localize 'GALACTICWARS.Sheet.Total'}}" data-tooltip-direction="UP">{{cpt.total}}%</span>
          </li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </div>
  </section>

  {{#if (or modeEdition system.sensibleForce)}}
  <section class="pouvoirs">
    <div class="section-header">
      <h2 class="eyebrow">
        {{#if modeEdition}}
        <label class="case-sensible-force">
          <input type="checkbox" name="system.sensibleForce" {{#if system.sensibleForce}}checked{{/if}}>
          {{localize 'GALACTICWARS.Sheet.SensibleForce'}}
        </label>
        {{else}}
        {{localize 'GALACTICWARS.Sheet.SensibleForce'}}
        {{/if}}
      </h2>
      {{#if system.sensibleForce}}<button type="button" class="roll-btn" data-action="createItem" data-type="pouvoir">+</button>{{/if}}
    </div>
    {{#if system.sensibleForce}}
    <div class="objet-liste">
      {{#each pouvoirs as |pouvoir|}}
      <div class="objet-row" data-item-id="{{pouvoir.id}}">
        <span class="objet-nom">{{pouvoir.name}}</span>
        <div class="objet-meta">
          <span class="mono valeur-secondaire">{{pouvoir.system.coutPointsDeForce}} PF</span>
          <button type="button" class="del-btn" data-action="deleteItem">🗑</button>
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}
  </section>
  {{/if}}
  {{/if}}

  {{#if (eq ongletActif 'equipements')}}
  <section class="inventaire-grid">
    <div class="panel">
      <div class="section-header">
        <h2 class="eyebrow">{{localize 'GALACTICWARS.Sheet.Armes'}}</h2>
        <button type="button" class="roll-btn" data-action="createItem" data-type="arme">+</button>
      </div>
      <div class="objet-liste">
        {{#each armes as |arme|}}
        <div class="objet-row" data-item-id="{{arme.id}}">
          <span class="objet-nom">{{arme.name}}</span>
          <div class="objet-meta">
            <span class="mono valeur-secondaire">{{arme.system.degats}}</span>
            <button type="button" class="del-btn" data-action="deleteItem">🗑</button>
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="panel">
      <div class="section-header">
        <h2 class="eyebrow">{{localize 'GALACTICWARS.Sheet.Armures'}}</h2>
        <button type="button" class="roll-btn" data-action="createItem" data-type="armure">+</button>
      </div>
      <div class="objet-liste">
        {{#each armures as |armure|}}
        <div class="objet-row" data-item-id="{{armure.id}}">
          <span class="objet-nom">{{armure.name}}</span>
          <div class="objet-meta">
            <span class="mono valeur-secondaire">+{{armure.system.reduction}}</span>
            <button type="button" class="del-btn" data-action="deleteItem">🗑</button>
          </div>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="panel">
      <div class="section-header">
        <h2 class="eyebrow">{{localize 'GALACTICWARS.Sheet.Equipement'}}</h2>
        <button type="button" class="roll-btn" data-action="createItem" data-type="equipement">+</button>
      </div>
      <div class="objet-liste">
        {{#each equipements as |objet|}}
        <div class="objet-row" data-item-id="{{objet.id}}">
          <span class="objet-nom">{{objet.name}}</span>
          <div class="objet-meta">
            <span class="mono valeur-secondaire">×{{objet.system.quantite}}</span>
            <button type="button" class="del-btn" data-action="deleteItem">🗑</button>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </section>
  {{/if}}

  {{#if (eq ongletActif 'informations')}}
  <section class="notes panel">
    <div class="section-header">
      <h2 class="eyebrow">{{localize 'GALACTICWARS.Sheet.OngletInformations'}}</h2>
      <button type="button" class="roll-btn" data-action="addNote">+</button>
    </div>
    {{#each system.notes as |note i|}}
    <div class="note-entry">
      <div class="note-header">
        <input type="text" class="note-titre" name="system.notes.{{i}}.titre" value="{{note.titre}}" placeholder="{{localize 'GALACTICWARS.Sheet.NoteTitrePlaceholder'}}">
        <button type="button" class="del-btn" data-action="removeNote" data-index="{{i}}">🗑</button>
      </div>
      <prose-mirror name="system.notes.{{i}}.contenu" value="{{note.contenu}}">{{{lookup ../notesEnrichies i}}}</prose-mirror>
    </div>
    {{/each}}
    {{#unless system.notes.length}}
    <p class="hint">{{localize 'GALACTICWARS.Sheet.AucuneNoteHint'}}</p>
    {{/unless}}
  </section>
  {{/if}}
  </div>
</div>
