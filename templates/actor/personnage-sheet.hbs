<form class="galactic-wars sheet personnage" autocomplete="off">
  <header class="sheet-header">
    <img class="portrait" src="{{system.portrait}}" data-action="editImage" alt="{{actor.name}}">
    <div class="header-fields">
      <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'GALACTICWARS.Sheet.Nom'}}">
      <div class="race-metier-row">
        <span>{{localize 'GALACTICWARS.Sheet.Race'}} : {{system.race.nom}}</span>
        <button type="button" data-action="applyRace">{{localize 'GALACTICWARS.Sheet.Appliquer'}}</button>
        <span>{{localize 'GALACTICWARS.Sheet.Metier'}} : {{system.metier.nom}}</span>
        <button type="button" data-action="applyMetier">{{localize 'GALACTICWARS.Sheet.Appliquer'}}</button>
      </div>
      <div class="niveau-row">
        <label>{{localize 'GALACTICWARS.Sheet.Niveau'}}</label>
        <input type="number" name="system.niveau" value="{{system.niveau}}">
      </div>
    </div>
  </header>

  <section class="caracteristiques">
    <h2>{{localize 'GALACTICWARS.Sheet.Caracteristiques'}}</h2>
    <div class="caracteristiques-grid">
      {{#each caracteristiques as |car|}}
      <div class="caracteristique">
        <label>{{localize car.label}}</label>
        <input type="number" name="system.caracteristiques.{{car.cle}}.base" value="{{car.base}}">
        <span class="racial">{{car.racial}}</span>
        <span class="total">= {{car.total}}</span>
      </div>
      {{/each}}
    </div>
  </section>

  <section class="ressources">
    <h2>{{localize 'GALACTICWARS.Sheet.Ressources'}}</h2>
    <label>{{localize 'GALACTICWARS.Sheet.PV'}}
      <input type="number" name="system.pv.value" value="{{system.pv.value}}"> /
      <input type="number" name="system.pv.max" value="{{system.pv.max}}">
    </label>
    <label>{{localize 'GALACTICWARS.Sheet.PointsDeForce'}}
      <input type="number" name="system.pointsDeForce.value" value="{{system.pointsDeForce.value}}"> /
      <input type="number" name="system.pointsDeForce.max" value="{{system.pointsDeForce.max}}">
    </label>
    <label>{{localize 'GALACTICWARS.Sheet.Stress'}}
      <input type="number" name="system.stress.value" value="{{system.stress.value}}"> /
      <input type="number" name="system.stress.max" value="{{system.stress.max}}">
    </label>
    <label>{{localize 'GALACTICWARS.Sheet.Alignement'}} ({{localize 'GALACTICWARS.Alignement.Obscurite'}} / {{localize 'GALACTICWARS.Alignement.Lumiere'}})
      <input type="range" name="system.alignement" min="-100" max="100" value="{{system.alignement}}">
    </label>
    <label>{{localize 'GALACTICWARS.Sheet.Credits'}} <input type="number" name="system.credits" value="{{system.credits}}" min="0"></label>
  </section>

  <section class="competences">
    <h2>{{localize 'GALACTICWARS.Sheet.Competences'}}</h2>
    <ul class="competences-list">
      {{#each competences as |cpt|}}
      <li class="competence-row {{#if cpt.estCompetenceForce}}force{{/if}}">
        <button type="button" data-action="rollCompetence" data-cle="{{cpt.cle}}">🎲</button>
        <span class="label">{{localize cpt.label}}{{#if cpt.estCompetenceMetier}} *{{/if}}</span>
        <input type="number" name="system.competences.{{@index}}.niveau" value="{{cpt.niveau}}" min="0" max="3">
        <span class="total">{{cpt.total}}%</span>
      </li>
      {{/each}}
    </ul>
    <p class="hint">* {{localize 'GALACTICWARS.Sheet.CompetenceMetierHint'}}</p>
  </section>

  <section class="inventaire">
    <h2>{{localize 'GALACTICWARS.Sheet.Armes'}}
      <button type="button" data-action="createItem" data-type="arme">+</button>
    </h2>
    <ul>
      {{#each armes as |arme|}}
      <li data-item-id="{{arme.id}}">{{arme.name}} — {{arme.system.degats}}
        <button type="button" data-action="deleteItem">🗑</button>
      </li>
      {{/each}}
    </ul>

    <h2>{{localize 'GALACTICWARS.Sheet.Armures'}}
      <button type="button" data-action="createItem" data-type="armure">+</button>
    </h2>
    <ul>
      {{#each armures as |armure|}}
      <li data-item-id="{{armure.id}}">{{armure.name}} — +{{armure.system.reduction}}
        <button type="button" data-action="deleteItem">🗑</button>
      </li>
      {{/each}}
    </ul>

    <h2>{{localize 'GALACTICWARS.Sheet.Pouvoirs'}}
      <button type="button" data-action="createItem" data-type="pouvoir">+</button>
    </h2>
    <ul>
      {{#each pouvoirs as |pouvoir|}}
      <li data-item-id="{{pouvoir.id}}">{{pouvoir.name}} ({{pouvoir.system.coutPointsDeForce}} PF)
        <button type="button" data-action="deleteItem">🗑</button>
      </li>
      {{/each}}
    </ul>

    <h2>{{localize 'GALACTICWARS.Sheet.Equipement'}}
      <button type="button" data-action="createItem" data-type="equipement">+</button>
    </h2>
    <ul>
      {{#each equipements as |objet|}}
      <li data-item-id="{{objet.id}}">{{objet.name}} x{{objet.system.quantite}}
        <button type="button" data-action="deleteItem">🗑</button>
      </li>
      {{/each}}
    </ul>
  </section>

  <section class="biographie">
    <h2>{{localize 'GALACTICWARS.Sheet.Biographie'}}</h2>
    <prose-mirror name="system.biographie" value="{{system.biographie}}">{{{biographieEnrichie}}}</prose-mirror>
  </section>
</form>
