{{!-- <div>, pas <form> : DocumentSheetV2 rend déjà this.element comme un <form>
      (classes déjà appliquées) — un <form> imbriqué ici ferait porter tous les
      inputs par ce <form> interne plutôt que par le vrai, et FormDataExtended
      (this.element) ne verrait plus aucun champ (voir JOURNAL.md, bug de
      sauvegarde des fiches). Un seul élément racine reste requis (PARTS). --}}
<div class="galactic-wars-body">
  <header class="sheet-header">
    <div class="portrait-frame">
      <img class="portrait" src="{{system.portrait}}" data-action="editImage" alt="{{actor.name}}">
    </div>
    <div class="header-fields">
      <div class="nom-row">
        <button type="button" class="btn btn-edition {{#if modeEdition}}active{{/if}}" data-action="basculerEdition"
                data-tooltip="{{localize 'GALACTICWARS.Sheet.ModeEditionHint'}}" aria-pressed="{{#if modeEdition}}true{{else}}false{{/if}}">
          <i class="fa-solid {{#if modeEdition}}fa-lock-open{{else}}fa-lock{{/if}}"></i>
          {{localize 'GALACTICWARS.Sheet.ModeEdition'}}
        </button>
        <input type="text" class="nom-input mono" name="name" value="{{actor.name}}" placeholder="{{localize 'GALACTICWARS.Sheet.Nom'}}">
      </div>
      <div class="race-metier-row">
        <span class="champ"><span class="eyebrow">{{localize 'GALACTICWARS.Sheet.Race'}}</span> <span class="valeur-texte">{{system.race.nom}}</span></span>
        {{#if modeEdition}}<button type="button" class="btn" data-action="applyRace">{{localize 'GALACTICWARS.Sheet.Choisir'}}</button>{{/if}}
        <span class="champ"><span class="eyebrow">{{localize 'GALACTICWARS.Sheet.Metier'}}</span> <span class="valeur-texte">{{system.metier.nom}}</span></span>
        {{#if modeEdition}}<button type="button" class="btn" data-action="applyMetier">{{localize 'GALACTICWARS.Sheet.Choisir'}}</button>{{/if}}
      </div>
      <div class="niveau-row">
        <span class="eyebrow">{{localize 'GALACTICWARS.Sheet.Niveau'}}</span>
        <input type="number" class="mono niveau-input" name="system.niveau" value="{{system.niveau}}">
      </div>
    </div>
    {{!-- PV / Force / Crédits dans l'en-tête : accessibles quel que soit l'onglet. (Stress retiré
         en attendant un système d'états actifs — system.stress reste dans le schéma.) --}}
    <div class="header-ressources stat-grid">
      <div class="stat-card stat-pv">
        <span class="eyebrow">{{localize 'GALACTICWARS.Sheet.PV'}}
          <button type="button" class="btn-repos" data-action="repos" data-tooltip="{{localize 'GALACTICWARS.Sheet.ReposHint'}}"><i class="fa-solid fa-bed"></i></button>
        </span>
        <div class="stat-value">
          <input type="number" class="mono" name="system.pv.value" value="{{system.pv.value}}">
          <span class="sep">/</span>
          <input type="number" class="mono max" name="system.pv.max" value="{{system.pv.max}}">
        </div>
        <div class="barre-pv {{barrePV.etat}}" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{barrePV.pourcentage}}"
             data-tooltip="{{barrePV.pourcentage}} %">
          <span class="remplissage" style="width: {{barrePV.pourcentage}}%"></span>
        </div>
      </div>
      <div class="stat-card stat-force">
        <span class="eyebrow">{{localize 'GALACTICWARS.Sheet.PointsDeForce'}}</span>
        {{!-- Ressource dépensable, pas une jauge valeur/max : seule .value est utilisée. --}}
        <div class="stat-value">
          <input type="number" class="mono" name="system.pointsDeForce.value" value="{{system.pointsDeForce.value}}" min="0">
        </div>
      </div>
      <div class="stat-card stat-credits">
        <span class="eyebrow">{{localize 'GALACTICWARS.Sheet.Credits'}}</span>
        {{!-- Un input number ne sait ni grouper les chiffres ni aller à la ligne : on affiche un
             texte formaté (espace tous les 3 chiffres, purement visuel) et l'input n'apparaît
             qu'au clic. La taille de police est réduite dans _onRender si ça déborde encore. --}}
        <div class="credits-affichage mono" tabindex="0" data-tooltip="{{system.credits}}">{{creditsFormates}}</div>
        <input type="number" class="mono credits-saisie" name="system.credits" value="{{system.credits}}" min="0" hidden>
      </div>
    </div>
  </header>

  <nav class="onglets">
    <button type="button" class="onglet-btn {{#if (eq ongletActif 'personnage')}}active{{/if}}" data-action="changerOnglet" data-onglet="personnage">{{localize 'GALACTICWARS.Sheet.OngletPersonnage'}}</button>
    <button type="button" class="onglet-btn {{#if (eq ongletActif 'equipements')}}active{{/if}}" data-action="changerOnglet" data-onglet="equipements">{{localize 'GALACTICWARS.Sheet.OngletEquipements'}}</button>
    <button type="button" class="onglet-btn {{#if (eq ongletActif 'informations')}}active{{/if}}" data-action="changerOnglet" data-onglet="informations">{{localize 'GALACTICWARS.Sheet.OngletInformations'}}</button>
    <button type="button" class="onglet-btn {{#if (eq ongletActif 'notes')}}active{{/if}}" data-action="changerOnglet" data-onglet="notes">{{localize 'GALACTICWARS.Sheet.OngletNotes'}}</button>
  </nav>

  <div class="sheet-body">
  {{#if (eq ongletActif 'personnage')}}
  <section class="ressources">
    <h2 class="eyebrow">{{localize 'GALACTICWARS.Sheet.Ressources'}}</h2>
    <div class="stat-grid">
      {{!-- Teinte de la carte : --rouge = part d'Obscurité (0-100), --intensite = réserve la plus haute / 10. --}}
      <div class="stat-card stat-alignement cote-{{equilibre.cote}}" style="--rouge: {{equilibre.rouge}}%; --intensite: {{equilibre.intensite}};">
        <div class="alignement-entete">
          <span class="eyebrow">{{localize 'GALACTICWARS.Alignement.Titre'}}</span>
          <span class="tendance">{{localize equilibre.tendance}}</span>
        </div>
        <div class="jauge-equilibre" role="meter" aria-valuemin="0" aria-valuemax="100"
             aria-valuenow="{{equilibre.curseur}}" data-tooltip="{{system.lumiere}} / {{system.obscurite}}">
          <span class="jauge-valeur valeur-lumiere mono">{{system.lumiere}}</span>
          <span class="jauge-piste"><span class="jauge-curseur" style="left: {{equilibre.curseur}}%"></span></span>
          <span class="jauge-valeur valeur-obscurite mono">{{system.obscurite}}</span>
        </div>
        <div class="pool pool-lumiere">
          <button type="button" class="pip-btn" data-action="ajusterLumiere" data-delta="-1">-</button>
          <span class="pips">
            {{#each pipsLumiere as |rempli|}}<span class="dot {{#if rempli}}dot-lumiere{{else}}dot-vide{{/if}}"></span>{{/each}}
          </span>
          <button type="button" class="pip-btn" data-action="ajusterLumiere" data-delta="1">+</button>
        </div>
        <div class="pool pool-obscurite">
          <button type="button" class="pip-btn" data-action="ajusterObscurite" data-delta="-1">-</button>
          <span class="pips">
            {{#each pipsObscurite as |rempli|}}<span class="dot {{#if rempli}}dot-obscurite{{else}}dot-vide{{/if}}"></span>{{/each}}
          </span>
          <button type="button" class="pip-btn" data-action="ajusterObscurite" data-delta="1">+</button>
        </div>
        <div class="bonus-choix">
          <label><input type="radio" name="bonusAlignement" value="aucun" checked> {{localize 'GALACTICWARS.Alignement.Aucun'}}</label>
          <label{{#unless system.lumiere}} class="disabled"{{/unless}}>
            <input type="radio" name="bonusAlignement" value="lumiere" {{#unless system.lumiere}}disabled{{/unless}}> {{localize 'GALACTICWARS.Alignement.Lumiere'}} (+{{bonusAlignement}}%)
          </label>
          <label{{#unless system.obscurite}} class="disabled"{{/unless}}>
            <input type="radio" name="bonusAlignement" value="obscurite" {{#unless system.obscurite}}disabled{{/unless}}> {{localize 'GALACTICWARS.Alignement.Obscurite'}} (+{{bonusAlignement}}%)
          </label>
        </div>
        <p class="hint">{{localize 'GALACTICWARS.Alignement.Hint'}}</p>
      </div>
    </div>
  </section>

  {{!-- Menu simplifié : compétences en favori, jet au clic. Masqué s'il n'y en a aucune. --}}
  {{#if favoris.length}}
  <section class="favoris panel">
    <div class="section-header">
      <h2 class="eyebrow"><i class="fa-solid fa-star"></i> {{localize 'GALACTICWARS.Favoris.Titre'}}</h2>
    </div>
    <div class="favoris-liste">
      {{#each favoris as |cpt|}}
      <button type="button" class="favori-carte car-{{cpt.caracteristique}} {{#if cpt.estCompetenceForce}}force{{/if}}"
              {{#if cpt.bloquee}}disabled data-tooltip="{{localize 'GALACTICWARS.Sheet.CompetenceBloquee'}}"{{else}}data-action="rollCompetence" data-cle="{{cpt.cle}}"{{/if}}>
        <span class="favori-nom">{{localize cpt.label}}</span>
        <span class="favori-total mono">{{cpt.total}}%</span>
      </button>
      {{/each}}
    </div>
  </section>
  {{/if}}

  <section class="caracteristiques">
    <div class="section-header">
      <h2 class="eyebrow">{{localize 'GALACTICWARS.Sheet.Caracteristiques'}} &amp; {{localize 'GALACTICWARS.Sheet.Competences'}}</h2>
      <div class="legende">
        <span class="legende-item"><span class="dot dot-metier"></span>{{localize 'GALACTICWARS.Sheet.CompetenceMetierHint'}}</span>
        <span class="legende-item"><span class="dot dot-force"></span>{{localize 'GALACTICWARS.Sheet.CompetenceLieeForce'}}</span>
      </div>
    </div>
    {{#if modeEdition}}
    <div class="points-caracteristiques {{pointsCaracteristiques.etat}}" data-tooltip="{{localize 'GALACTICWARS.Sheet.PointsCaracteristiquesHint'}}">
      <span class="eyebrow">{{localize 'GALACTICWARS.Sheet.PointsCaracteristiques'}}</span>
      <span class="mono valeur">{{pointsCaracteristiques.valeur}} / {{pointsCaracteristiques.attendu}}</span>
      {{#if (eq pointsCaracteristiques.etat 'manque')}}<span class="etat">{{localize 'GALACTICWARS.Sheet.PointsCaracteristiquesManque'}}</span>{{/if}}
      {{#if (eq pointsCaracteristiques.etat 'exces')}}<span class="etat">{{localize 'GALACTICWARS.Sheet.PointsCaracteristiquesExces'}}</span>{{/if}}
    </div>
    {{/if}}
    <div class="caracteristiques-grid">
      {{#each caracteristiques as |car|}}
      <div class="colonne-caracteristique car-{{car.cle}}">
        <div class="caracteristique">
          <label>{{localize car.label}}</label>
          <span class="total mono" data-tooltip="{{localize 'GALACTICWARS.Sheet.Total'}}">{{car.total}}</span>
          <div class="detail-caracteristique">
            {{!-- Hors mode édition, pas d'input : la base n'est pas soumise, donc pas modifiée
                  (SchemaField, un champ absent du formulaire est simplement ignoré). --}}
            {{#if @root.modeEdition}}
            <input type="number" name="system.caracteristiques.{{car.cle}}.base" value="{{car.base}}" data-tooltip="{{localize 'GALACTICWARS.Sheet.ValeurInput'}}">
            {{else}}
            <span class="base-lecture mono" data-tooltip="{{localize 'GALACTICWARS.Sheet.ValeurInput'}}">{{car.base}}</span>
            {{/if}}
            <span class="racial mono" data-tooltip="{{localize 'GALACTICWARS.Sheet.BonusRacial'}}">{{#if car.racial}}{{#if (gt car.racial 0)}}+{{/if}}{{car.racial}}{{else}}+0{{/if}}</span>
          </div>
        </div>
        <ul class="competences-list {{#unless @root.modeEdition}}lecture{{/unless}}">
          <li class="skill-row competences-entete" aria-hidden="true">
            <span class="entete-nom">{{localize 'GALACTICWARS.Sheet.Nom'}}</span>
            <span>{{localize 'GALACTICWARS.Sheet.NiveauCourt'}}</span>
            {{#if @root.modeEdition}}<span>{{localize 'GALACTICWARS.Sheet.AjustementCourt'}}</span>{{/if}}
            <span>{{localize 'GALACTICWARS.Sheet.Total'}}</span>
          </li>
          {{#each car.competences as |cpt|}}
          <li class="competence-row skill-row {{#if cpt.estCompetenceForce}}force{{/if}} {{#if cpt.estReservee}}reservee{{/if}} {{#if cpt.bloquee}}bloquee{{/if}} {{#if cpt.acquiseParMetier}}acquise{{/if}}"
              data-index="{{cpt.index}}"
              {{#if cpt.bloquee}}data-tooltip="{{#if @root.isGM}}{{localize 'GALACTICWARS.Sheet.CompetenceBloqueeMJ'}}{{else}}{{localize 'GALACTICWARS.Sheet.CompetenceBloquee'}}{{/if}}"{{/if}}>
            <span class="label" data-cle="{{cpt.cle}}" {{#unless cpt.bloquee}}data-action="rollCompetence" role="button"{{/unless}}><button type="button" class="favori-btn {{#if cpt.favori}}actif{{/if}}" data-action="basculerFavori" data-index="{{cpt.index}}" data-tooltip="{{#if cpt.favori}}{{localize 'GALACTICWARS.Favoris.Retirer'}}{{else}}{{localize 'GALACTICWARS.Favoris.Ajouter'}}{{/if}}"><i class="{{#if cpt.favori}}fa-solid{{else}}fa-regular{{/if}} fa-star"></i></button>{{#if cpt.recommandee}}<span class="dot dot-metier"></span>{{/if}}{{#if cpt.estCompetenceForce}}<span class="dot dot-force"></span>{{/if}}{{localize cpt.label}}{{#if cpt.bloquee}} <i class="fa-solid fa-lock cadenas"></i>{{/if}}</span>
            {{!-- system.competences est un ArrayField : Document#update() remplace chaque élément
                  entier plutôt que de fusionner ses champs un par un. TOUT champ d'une compétence
                  doit donc être soumis à chaque sauvegarde, même quand il n'est pas modifiable
                  (hors mode édition, compétence bloquée) — sinon il serait réinitialisé à sa
                  valeur par défaut du schéma (cle: "" notamment, ce qui casse GW.competences[cle]
                  partout ; niveau/ajustement remis à 0). --}}
            <input type="hidden" name="system.competences.{{cpt.index}}.cle" value="{{cpt.cle}}">
            <input type="hidden" name="system.competences.{{cpt.index}}.racial" value="{{cpt.racial}}" data-dtype="Number">
            <input type="hidden" name="system.competences.{{cpt.index}}.metier" value="{{cpt.metier}}" data-dtype="Number">
            <input type="hidden" name="system.competences.{{cpt.index}}.acquiseParMetier" value="{{cpt.acquiseParMetier}}" data-dtype="Boolean">
            <input type="hidden" name="system.competences.{{cpt.index}}.recommandee" value="{{cpt.recommandee}}" data-dtype="Boolean">
            <input type="hidden" name="system.competences.{{cpt.index}}.debloquee" value="{{cpt.debloquee}}" data-dtype="Boolean">
            <input type="hidden" name="system.competences.{{cpt.index}}.favori" value="{{cpt.favori}}" data-dtype="Boolean">
            {{#if (and @root.modeEdition (not cpt.bloquee))}}
            <input type="number" class="niveau mono" name="system.competences.{{cpt.index}}.niveau" value="{{cpt.niveau}}" min="0" max="3" data-tooltip="{{localize 'GALACTICWARS.Sheet.Niveau'}}">
            {{else}}
            <input type="hidden" name="system.competences.{{cpt.index}}.niveau" value="{{cpt.niveau}}" data-dtype="Number">
            <span class="niveau niveau-lecture mono" data-tooltip="{{localize 'GALACTICWARS.Sheet.Niveau'}}">{{#if cpt.bloquee}}0{{else}}{{cpt.niveau}}{{/if}}</span>
            {{/if}}
            {{#if @root.modeEdition}}
            <input type="number" class="ajustement mono" name="system.competences.{{cpt.index}}.ajustement" value="{{cpt.ajustement}}" data-tooltip="{{localize 'GALACTICWARS.Sheet.AjustementManuelHint'}}">
            {{else}}
            <input type="hidden" name="system.competences.{{cpt.index}}.ajustement" value="{{cpt.ajustement}}" data-dtype="Number">
            {{/if}}
            <span class="total mono" data-tooltip="{{localize 'GALACTICWARS.Sheet.Total'}}" data-tooltip-direction="UP">{{cpt.total}}%</span>
          </li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </div>
  </section>

  {{#if (or modeEdition system.sensibleForce)}}
  <section class="pouvoirs">
    <div class="section-header">
      <h2 class="eyebrow">
        {{#if modeEdition}}
        <label class="case-sensible-force">
          <input type="checkbox" name="system.sensibleForce" {{#if system.sensibleForce}}checked{{/if}}>
          {{localize 'GALACTICWARS.Sheet.SensibleForce'}}
        </label>
        {{else}}
        {{localize 'GALACTICWARS.Sheet.SensibleForce'}}
        {{/if}}
      </h2>
      {{#if system.sensibleForce}}<button type="button" class="roll-btn" data-action="createItem" data-type="pouvoir">+</button>{{/if}}
    </div>
    {{#if system.sensibleForce}}
    <div class="objet-liste">
      {{#each pouvoirs as |pouvoir|}}
      <div class="objet-row" data-item-id="{{pouvoir.id}}">
        <span class="objet-nom">{{pouvoir.name}}</span>
        <div class="objet-meta">
          <span class="mono valeur-secondaire">{{pouvoir.system.coutPointsDeForce}} PF</span>
          <button type="button" class="del-btn" data-action="deleteItem">🗑</button>
        </div>
      </div>
      {{/each}}
    </div>
    {{/if}}
  </section>
  {{/if}}
  {{/if}}

  {{#if (eq ongletActif 'equipements')}}
  {{!-- Ligne d'inventaire (préparée par PersonnageSheet#preparerInventaire). Clic = carte dans
        le tchat, clic droit = menu (porter/ranger, tags, tchat, fiche, suppression). Objet
        rangé atténué ; l'indicateur de gauche bascule porté/rangé. --}}
  {{#*inline "gwLigneObjet"}}
  <div class="objet-row inventaire-ligne {{#unless ligne.porte}}range{{/unless}} {{#if ligne.cache}}tag-cache{{/if}}"
       data-item-id="{{ligne.id}}" data-action="afficherObjet" role="button" tabindex="0">
    <button type="button" class="porte-btn {{#if ligne.porte}}actif{{/if}}" data-action="basculerPorteObjet"
            aria-pressed="{{#if ligne.porte}}true{{else}}false{{/if}}"
            data-tooltip="{{#if ligne.porte}}{{localize 'GALACTICWARS.Objet.Porte'}} — {{localize 'GALACTICWARS.Objet.Ranger'}}{{else}}{{localize 'GALACTICWARS.Objet.Range'}} — {{localize 'GALACTICWARS.Objet.Porter'}}{{/if}}">
      <i class="fa-solid {{#if ligne.porte}}fa-hand-fist{{else}}fa-box-archive{{/if}}"></i>
    </button>
    <img class="objet-img" src="{{ligne.img}}" alt="">
    <div class="objet-corps">
      <span class="objet-nom">{{ligne.name}}</span>
      {{#if (or ligne.porte ligne.badges.length)}}
      <span class="objet-badges">
        {{#if ligne.porte}}<span class="badge-tag badge-porte"><i class="fa-solid fa-hand-fist"></i> {{localize 'GALACTICWARS.Objet.Porte'}}</span>{{/if}}
        {{#each ligne.badges as |badge|}}
        <span class="badge-tag badge-{{badge.cle}}" {{#if badge.hint}}data-tooltip="{{localize badge.hint}}"{{/if}}><i class="{{badge.icone}}"></i> {{localize badge.label}}</span>
        {{/each}}
      </span>
      {{/if}}
    </div>
    <div class="objet-meta">
      <span class="mono valeur-cle">{{ligne.valeur}}</span>
      {{#if ligne.attaqueRapide}}
      <button type="button" class="roll-btn attaque-btn" data-action="attaquerObjet" data-tooltip="{{localize 'GALACTICWARS.Objet.Attaquer'}}">
        <i class="fa-solid fa-crosshairs"></i>
      </button>
      {{/if}}
    </div>
  </div>
  {{/inline}}

  <section class="inventaire-grid">
    <div class="panel panel-armes">
      <div class="section-header">
        <h2 class="eyebrow">{{localize 'GALACTICWARS.Sheet.Armes'}}</h2>
        <button type="button" class="roll-btn" data-action="createItem" data-type="arme">+</button>
      </div>
      {{!-- Même groupe radio que l'onglet Personnage (un seul onglet est rendu à la fois) :
            la réserve choisie s'applique à l'attaque rapide, voir #onAttaquerObjet. --}}
      <div class="bonus-choix inventaire-bonus">
        <label><input type="radio" name="bonusAlignement" value="aucun" checked> {{localize 'GALACTICWARS.Alignement.Aucun'}}</label>
        <label{{#unless system.lumiere}} class="disabled"{{/unless}}>
          <input type="radio" name="bonusAlignement" value="lumiere" {{#unless system.lumiere}}disabled{{/unless}}> {{localize 'GALACTICWARS.Alignement.Lumiere'}} (+{{bonusAlignement}}%)
        </label>
        <label{{#unless system.obscurite}} class="disabled"{{/unless}}>
          <input type="radio" name="bonusAlignement" value="obscurite" {{#unless system.obscurite}}disabled{{/unless}}> {{localize 'GALACTICWARS.Alignement.Obscurite'}} (+{{bonusAlignement}}%)
        </label>
      </div>
      <div class="objet-liste">
        {{#each armes as |arme|}}{{> gwLigneObjet ligne=arme}}{{else}}<p class="inventaire-vide">{{localize 'GALACTICWARS.Objet.ListeVide'}}</p>{{/each}}
      </div>
    </div>

    <div class="panel panel-armures">
      <div class="section-header">
        <h2 class="eyebrow">{{localize 'GALACTICWARS.Objet.ArmuresBoucliers'}}</h2>
        <span class="reduction-totale mono" data-tooltip="{{localize 'GALACTICWARS.Objet.ReductionTotale'}}">
          <i class="fa-solid fa-shield-halved"></i> {{reductionTotale}}
        </span>
        <button type="button" class="roll-btn" data-action="createItem" data-type="armure">+</button>
      </div>
      <div class="objet-liste">
        {{#each armures as |armure|}}{{> gwLigneObjet ligne=armure}}{{else}}<p class="inventaire-vide">{{localize 'GALACTICWARS.Objet.ListeVide'}}</p>{{/each}}
      </div>
    </div>

    <div class="panel panel-equipement">
      <div class="section-header">
        <h2 class="eyebrow">{{localize 'GALACTICWARS.Sheet.Equipement'}}</h2>
        <button type="button" class="roll-btn" data-action="createItem" data-type="equipement">+</button>
      </div>
      <div class="objet-liste">
        {{#each equipements as |objet|}}{{> gwLigneObjet ligne=objet}}{{else}}<p class="inventaire-vide">{{localize 'GALACTICWARS.Objet.ListeVide'}}</p>{{/each}}
      </div>
    </div>
  </section>
  {{/if}}

  {{#if (eq ongletActif 'informations')}}
  {{!-- Description du personnage : champs simples (SchemaField, sûrs avec la sauvegarde
        automatique) + texte libre. --}}
  <section class="description-pj panel">
    <div class="section-header">
      <h2 class="eyebrow">{{localize 'GALACTICWARS.Notes.DescriptionPersonnage'}}</h2>
    </div>
    <div class="identite-grille">
      {{#each champsIdentite as |champ|}}
      <label class="identite-champ">
        <span class="eyebrow">{{localize champ.label}}</span>
        <input type="text" name="system.infos.{{champ.cle}}" value="{{champ.valeur}}">
      </label>
      {{/each}}
    </div>
    <prose-mirror name="system.description" value="{{system.description}}" toggled>{{{descriptionEnrichie}}}</prose-mirror>
  </section>

  {{!-- Traits (Items « talent » portés) : masqué tant qu'il n'y en a aucun, sauf en mode édition. --}}
  {{#if afficherTraits}}
  <section class="traits panel">
    <div class="section-header">
      <h2 class="eyebrow">{{localize 'GALACTICWARS.Traits.Titre'}}</h2>
      {{#if modeEdition}}
      <button type="button" class="roll-btn" data-action="ajouterTrait" data-tooltip="{{localize 'GALACTICWARS.Traits.Ajouter'}}">+</button>
      {{/if}}
    </div>
    {{#if traits.length}}
    <table class="traits-table">
      <thead>
        <tr>
          <th>{{localize 'GALACTICWARS.Traits.Nom'}}</th>
          <th>{{localize 'GALACTICWARS.Traits.Avantage'}}</th>
          <th>{{localize 'GALACTICWARS.Traits.Inconvenient'}}</th>
          {{#if modeEdition}}<th></th>{{/if}}
        </tr>
      </thead>
      <tbody>
        {{#each traits as |trait|}}
        <tr data-item-id="{{trait.id}}">
          <td class="trait-nom"><a data-action="ouvrirObjet"><img src="{{trait.img}}" alt="">{{trait.name}}</a></td>
          <td class="trait-avantage">{{trait.system.avantage}}</td>
          <td class="trait-inconvenient">{{trait.system.inconvenient}}</td>
          {{#if @root.modeEdition}}<td class="trait-actions"><button type="button" class="del-btn" data-action="deleteItem" data-tooltip="{{localize 'GALACTICWARS.Traits.Retirer'}}">🗑</button></td>{{/if}}
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{else}}
    <p class="hint">{{localize 'GALACTICWARS.Traits.Aucun'}}</p>
    {{/if}}
  </section>
  {{/if}}

  {{!-- Ethnie : compétences spéciales et modificateurs, en lecture seule depuis l'Item race lié. --}}
  <section class="ethnie panel">
    <div class="section-header">
      <h2 class="eyebrow">{{localize 'GALACTICWARS.Notes.Ethnie'}}</h2>
    </div>
    {{#if ethnie.trouvee}}
    <div class="ethnie-contenu">
      <img class="ethnie-portrait" src="{{ethnie.img}}" alt="{{ethnie.nom}}">
      <div class="ethnie-details">
        <h3 class="ethnie-nom">{{ethnie.nom}}</h3>
        <div class="ethnie-description">{{{ethnie.description}}}</div>
        {{#if ethnie.caracteristiques.length}}
        <div class="ethnie-groupe">
          <h4 class="eyebrow">{{localize 'GALACTICWARS.Notes.ModificateursCaracteristiques'}}</h4>
          <div class="ethnie-modificateurs">
            {{#each ethnie.caracteristiques as |m|}}<span class="etiquette {{m.sens}}">{{m.label}} {{m.valeur}}</span>{{/each}}
          </div>
        </div>
        {{/if}}
        {{#if ethnie.competences.length}}
        <div class="ethnie-groupe">
          <h4 class="eyebrow">{{localize 'GALACTICWARS.Notes.ModificateursCompetences'}}</h4>
          <div class="ethnie-modificateurs">
            {{#each ethnie.competences as |m|}}<span class="etiquette {{m.sens}}">{{m.label}} {{m.valeur}}</span>{{/each}}
          </div>
        </div>
        {{/if}}
        {{#if ethnie.armureNaturelle}}
        <div class="ethnie-groupe">
          <h4 class="eyebrow">{{localize 'GALACTICWARS.Notes.ArmureNaturelle'}}</h4>
          <div class="ethnie-modificateurs"><span class="etiquette bonus">+{{ethnie.armureNaturelle}}</span></div>
        </div>
        {{/if}}
      </div>
    </div>
    {{else}}
    <p class="hint">{{#if ethnie.nom}}{{localize 'GALACTICWARS.Notes.EthnieNonLiee'}}{{else}}{{localize 'GALACTICWARS.Notes.AucuneEthnie'}}{{/if}}</p>
    {{/if}}
  </section>
  {{/if}}

  {{#if (eq ongletActif 'notes')}}
  <nav class="sous-onglets">
    <button type="button" class="sous-onglet-btn {{#if (eq sousOngletNotes 'resume')}}active{{/if}}" data-action="changerSousOnglet" data-sous-onglet="resume">{{localize 'GALACTICWARS.Notes.Resumes'}} <span class="compteur">{{resumes.length}}</span></button>
    <button type="button" class="sous-onglet-btn {{#if (eq sousOngletNotes 'infos')}}active{{/if}}" data-action="changerSousOnglet" data-sous-onglet="infos">{{localize 'GALACTICWARS.Notes.Infos'}} <span class="compteur">{{infos.length}}</span></button>
    <button type="button" class="sous-onglet-btn {{#if (eq sousOngletNotes 'pnj')}}active{{/if}}" data-action="changerSousOnglet" data-sous-onglet="pnj">{{localize 'GALACTICWARS.Notes.Pnj'}} <span class="compteur">{{pnjs.length}}</span></button>
    <button type="button" class="sous-onglet-btn {{#if (eq sousOngletNotes 'missions')}}active{{/if}}" data-action="changerSousOnglet" data-sous-onglet="missions">{{localize 'GALACTICWARS.Notes.Missions'}} <span class="compteur">{{missions.length}}</span></button>
  </nav>

  {{#if (eq sousOngletNotes 'resume')}}
  <section class="notes panel {{#if modeEdition}}texte-complet{{/if}}">
    <div class="section-header">
      <h2 class="eyebrow">{{localize 'GALACTICWARS.Notes.Resumes'}}</h2>
      <button type="button" class="roll-btn" data-action="ajouterEntreeNote" data-type="resume" data-tooltip="{{localize 'GALACTICWARS.Notes.Ajouter'}}">+</button>
    </div>
    {{#each resumes as |resume|}}
    <article class="carte-note" data-type="resume" data-index="{{resume.index}}" data-action="editerEntreeNote">
      <header class="carte-entete">
        <span class="carte-titre">{{resume.titre}}</span>
        {{#if resume.dateLabel}}<span class="carte-date" data-tooltip="{{localize 'GALACTICWARS.Notes.DateHint'}}">{{resume.dateLabel}}</span>{{/if}}
        <button type="button" class="del-btn" data-action="supprimerEntreeNote" data-tooltip="{{localize 'GALACTICWARS.Notes.Supprimer'}}">🗑</button>
      </header>
      <div class="carte-texte">{{{resume.descriptionEnrichie}}}</div>
    </article>
    {{else}}
    <p class="hint">{{localize 'GALACTICWARS.Notes.AucunResume'}}</p>
    {{/each}}
  </section>
  {{/if}}

  {{#if (eq sousOngletNotes 'infos')}}
  <section class="notes panel {{#if modeEdition}}texte-complet{{/if}}">
    <div class="section-header">
      <h2 class="eyebrow">{{localize 'GALACTICWARS.Notes.Infos'}}</h2>
      <button type="button" class="roll-btn" data-action="ajouterEntreeNote" data-type="info" data-tooltip="{{localize 'GALACTICWARS.Notes.Ajouter'}}">+</button>
    </div>
    {{#each infos as |info|}}
    <article class="carte-note" data-type="info" data-index="{{info.index}}" data-action="editerEntreeNote">
      <header class="carte-entete">
        <span class="carte-titre">{{info.titre}}</span>
        <button type="button" class="del-btn" data-action="supprimerEntreeNote" data-tooltip="{{localize 'GALACTICWARS.Notes.Supprimer'}}">🗑</button>
      </header>
      {{#if info.motsCles.length}}<div class="mots-cles">{{#each info.motsCles as |mot|}}<span class="etiquette">{{mot}}</span>{{/each}}</div>{{/if}}
      <div class="carte-texte">{{{info.contenuEnrichi}}}</div>
    </article>
    {{else}}
    <p class="hint">{{localize 'GALACTICWARS.Notes.AucuneInfo'}}</p>
    {{/each}}
  </section>
  {{/if}}

  {{#if (eq sousOngletNotes 'pnj')}}
  <section class="notes panel {{#if modeEdition}}texte-complet{{/if}}">
    <div class="section-header">
      <h2 class="eyebrow">{{localize 'GALACTICWARS.Notes.Pnj'}}</h2>
      <button type="button" class="roll-btn" data-action="ajouterEntreeNote" data-type="pnj" data-tooltip="{{localize 'GALACTICWARS.Notes.Ajouter'}}">+</button>
    </div>
    {{#each pnjs as |pnj|}}
    <article class="carte-note statut-{{pnj.statut}} {{#if pnj.img}}avec-image{{/if}}" data-type="pnj" data-index="{{pnj.index}}" data-action="editerEntreeNote">
      {{#if pnj.img}}<img class="carte-image" src="{{pnj.img}}" alt="{{pnj.nom}}">{{/if}}
      <div class="carte-corps">
        <header class="carte-entete">
          <span class="carte-titre">{{pnj.nom}}</span>
          <span class="pastille statut-{{pnj.statut}}">{{pnj.statutLabel}}</span>
          <button type="button" class="del-btn" data-action="supprimerEntreeNote" data-tooltip="{{localize 'GALACTICWARS.Notes.Supprimer'}}">🗑</button>
        </header>
        {{#if pnj.sousTitre}}<div class="carte-sous-titre">{{pnj.sousTitre}}</div>{{/if}}
        <div class="carte-texte">{{{pnj.descriptionEnrichie}}}</div>
      </div>
    </article>
    {{else}}
    <p class="hint">{{localize 'GALACTICWARS.Notes.AucunPnj'}}</p>
    {{/each}}
  </section>
  {{/if}}

  {{#if (eq sousOngletNotes 'missions')}}
  <section class="notes panel {{#if modeEdition}}texte-complet{{/if}}">
    <div class="section-header">
      <h2 class="eyebrow">{{localize 'GALACTICWARS.Notes.Missions'}}</h2>
      <button type="button" class="roll-btn" data-action="ajouterEntreeNote" data-type="mission" data-tooltip="{{localize 'GALACTICWARS.Notes.Ajouter'}}">+</button>
    </div>
    {{#each missions as |mission|}}
    <article class="carte-note mission-{{mission.statut}}" data-type="mission" data-index="{{mission.index}}" data-action="editerEntreeNote">
      <header class="carte-entete">
        <span class="carte-titre">{{mission.titre}}</span>
        <span class="pastille importance-{{mission.importance}}">{{mission.importanceLabel}}</span>
        <span class="pastille mission-{{mission.statut}}">{{mission.statutLabel}}</span>
        <button type="button" class="del-btn" data-action="supprimerEntreeNote" data-tooltip="{{localize 'GALACTICWARS.Notes.Supprimer'}}">🗑</button>
      </header>
      <div class="carte-texte">{{{mission.descriptionEnrichie}}}</div>
    </article>
    {{else}}
    <p class="hint">{{localize 'GALACTICWARS.Notes.AucuneMission'}}</p>
    {{/each}}
  </section>
  {{/if}}
  {{/if}}
  </div>
</div>
