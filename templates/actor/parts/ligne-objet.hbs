{{!-- Ligne d'inventaire des onglets Équipements et Combat (préparée par PersonnageSheet#preparerInventaire).
      Clic = carte dans le tchat (Datapad / Comlink : leur onglet Holonet / Comlink), clic droit = menu (porter /
      ranger, tags, tchat, fiche, suppression). Objet rangé atténué ; le bouton de droite bascule porté / rangé. --}}
<div class="objet-row inventaire-ligne draggable {{#unless ligne.porte}}range{{/unless}} {{#if ligne.cache}}tag-cache{{/if}}"
     data-item-id="{{ligne.id}}" data-action="afficherObjet" role="button" tabindex="0">
  <img class="objet-img" src="{{ligne.img}}" alt="">
  <div class="objet-corps">
    <span class="objet-nom">{{ligne.name}}</span>
    {{#if (or ligne.porte ligne.badges.length)}}
    <span class="objet-badges">
      {{#if ligne.porte}}<span class="badge-tag badge-porte"><i class="fa-solid fa-hand-fist"></i> {{localize 'GALACTICWARS.Objet.Porte'}}</span>{{/if}}
      {{#each ligne.badges as |badge|}}
      <span class="badge-tag badge-{{badge.cle}}" {{#if badge.hint}}data-tooltip="{{localize badge.hint}}"{{/if}}><i class="{{badge.icone}}"></i> {{localize badge.label}}</span>
      {{/each}}
    </span>
    {{/if}}
  </div>
  <div class="objet-meta">
    {{#if ligne.libelleValeur}}<span class="valeur-libelle">{{localize ligne.libelleValeur}}</span>{{/if}}
    <span class="mono valeur-cle">{{ligne.valeur}}</span>
    {{#if ligne.degatsRapide}}
    <button type="button" class="roll-btn degats-btn" data-action="degatsObjet" data-tooltip="{{localize 'GALACTICWARS.Objet.LancerDegats'}}">
      <i class="fa-solid fa-burst"></i>
    </button>
    {{/if}}
    <button type="button" class="porte-btn {{#if ligne.porte}}actif{{/if}}" data-action="basculerPorteObjet"
            aria-pressed="{{#if ligne.porte}}true{{else}}false{{/if}}"
            data-tooltip="{{#if ligne.porte}}{{localize 'GALACTICWARS.Objet.Porte'}} — {{localize 'GALACTICWARS.Objet.Ranger'}}{{else}}{{localize 'GALACTICWARS.Objet.Range'}} — {{localize 'GALACTICWARS.Objet.Porter'}}{{/if}}">
      <i class="fa-solid {{#if ligne.porte}}fa-hand-fist{{else}}fa-box-archive{{/if}}"></i>
    </button>
    {{#if @root.modeEdition}}
    <button type="button" class="roll-btn editer-objet-btn" data-action="ouvrirObjet" data-tooltip="{{localize 'GALACTICWARS.Objet.Modifier'}}">
      <i class="fa-solid fa-pen-to-square"></i>
    </button>
    {{!-- Suppression : onglet Équipements seulement (le partiel sert aussi à l'onglet Combat). --}}
    {{#if (eq @root.ongletActif 'equipements')}}
    <button type="button" class="roll-btn supprimer-objet-btn" data-action="supprimerObjet" data-tooltip="{{localize 'GALACTICWARS.Objet.SupprimerObjet'}}" aria-label="{{localize 'GALACTICWARS.Objet.SupprimerObjet'}}">
      <i class="fa-solid fa-trash"></i>
    </button>
    {{/if}}
    {{/if}}
  </div>
</div>
