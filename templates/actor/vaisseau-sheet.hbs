{{!-- <div>, pas <form> : DocumentSheetV2 rend déjà this.element comme un <form>
      (classes déjà appliquées) — un <form> imbriqué casserait FormDataExtended.
      Un seul élément racine reste requis (PARTS).
      Mise en page d'après asset_fiche_perso/mokcup_exemple_fiche_vaiseau.jfif.
      Hors mode Édition : identité, maximums, postes et aménagements en lecture ; restent utilisables en jeu la
      coque, les points de bouclier, l'interrupteur, le déplacement, les armes (clic = carte d'attaque) et
      l'équipage (noms, glisser-déposer d'acteurs). --}}
<div class="galactic-wars-body {{#if modeEdition}}mode-edition{{else}}mode-lecture{{/if}}">
  <div class="sheet-body">

  <section class="vs-haut">
    {{#if modeEdition}}
    <button type="button" class="vs-plan" data-action="editImage" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.ChangerImage'}}">
      <img src="{{plan}}" alt="{{actor.name}}">
    </button>
    {{else}}
    <div class="vs-plan"><img src="{{plan}}" alt="{{actor.name}}"></div>
    {{/if}}

    <div class="vs-identite">
      <div class="vs-champ">
        <span class="vs-label-ligne">
          <span class="vs-label">{{localize 'GALACTICWARS.Sheet.Nom'}}</span>
          {{#if editable}}
          <button type="button" class="vs-edition {{#if modeEdition}}actif{{/if}}" data-action="basculerEdition"
                  aria-pressed="{{#if modeEdition}}true{{else}}false{{/if}}"
                  data-tooltip="{{#if modeEdition}}{{localize 'GALACTICWARS.Vaisseau.QuitterEdition'}}{{else}}{{localize 'GALACTICWARS.Vaisseau.PasserEdition'}}{{/if}}">
            <i class="fa-solid {{#if modeEdition}}fa-lock-open{{else}}fa-lock{{/if}}"></i> {{localize 'GALACTICWARS.Sheet.ModeEdition'}}
          </button>
          {{/if}}
        </span>
        {{#if modeEdition}}
        <input type="text" name="name" value="{{actor.name}}" class="vs-nom">
        {{else}}
        <span class="vs-valeur-texte vs-nom">{{actor.name}}</span>
        {{/if}}
      </div>
      <div class="vs-ligne-identite">
        <div class="vs-champ vs-classe">
          <span class="vs-label">{{localize 'GALACTICWARS.Sheet.Classe'}}</span>
          {{#if modeEdition}}<input type="text" name="system.classe" value="{{system.classe}}">
          {{else}}<span class="vs-valeur-texte">{{system.classe}}</span>{{/if}}
        </div>
        <div class="vs-champ vs-taille">
          <span class="vs-label">{{localize 'GALACTICWARS.Sheet.Taille'}}</span>
          {{#if modeEdition}}<input type="text" name="system.taille" value="{{system.taille}}">
          {{else}}<span class="vs-valeur-texte">{{system.taille}}</span>{{/if}}
        </div>
        <div class="vs-champ vs-prix">
          <span class="vs-label">{{localize 'GALACTICWARS.Sheet.Prix'}}</span>
          <span class="vs-prix-saisie">
            {{#if modeEdition}}<input type="text" name="system.prix" value="{{system.prix}}">
            {{else}}<span class="vs-valeur-texte">{{system.prix}}</span>{{/if}}
            <i class="fa-solid fa-coins"></i>
          </span>
        </div>
      </div>

      <div class="vs-panneau vs-ressources {{#if bouclierInactif}}bouclier-inactif{{/if}}">
        <h2 class="vs-titre">{{localize 'GALACTICWARS.Sheet.Ressources'}}</h2>
        <div class="vs-jauges">
          <div class="vs-jauge vs-jauge-coque etat-{{jauges.coque.etat}}">
            <span class="vs-label">{{localize 'GALACTICWARS.Vaisseau.Coque'}}</span>
            <div class="vs-cadran">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <circle class="vs-piste" cx="50" cy="50" r="40" stroke-dasharray="{{jauges.coque.arc}} {{jauges.coque.circonference}}"/>
                <circle class="vs-valeur {{#unless jauges.coque.ratio}}vide{{/unless}}" cx="50" cy="50" r="40" stroke-dasharray="{{jauges.coque.rempli}} {{jauges.coque.circonference}}"/>
              </svg>
              <span class="vs-cadran-saisie">
                <input type="number" name="system.pv.actuels" value="{{system.pv.actuels}}" class="vs-grand" aria-label="{{localize 'GALACTICWARS.Vaisseau.CoqueActuelle'}}">
                {{#if modeEdition}}
                <input type="number" name="system.pv.max" value="{{system.pv.max}}" class="vs-petit" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.Maximum'}}" aria-label="{{localize 'GALACTICWARS.Vaisseau.Maximum'}}">
                {{else}}
                <span class="vs-petit mono" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.Maximum'}}">{{system.pv.max}}</span>
                {{/if}}
              </span>
            </div>
          </div>

          <div class="vs-jauge vs-jauge-bouclier">
            <span class="vs-label">{{localize 'GALACTICWARS.Vaisseau.BouclierPoints'}}</span>
            <div class="vs-cadran">
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <circle class="vs-piste" cx="50" cy="50" r="40" stroke-dasharray="{{jauges.bouclier.arc}} {{jauges.bouclier.circonference}}"/>
                <circle class="vs-valeur {{#unless jauges.bouclier.ratio}}vide{{/unless}}" cx="50" cy="50" r="40" stroke-dasharray="{{jauges.bouclier.rempli}} {{jauges.bouclier.circonference}}"/>
              </svg>
              <span class="vs-cadran-saisie">
                <input type="number" name="system.bouclier.points" value="{{system.bouclier.points}}" class="vs-grand" aria-label="{{localize 'GALACTICWARS.Vaisseau.BouclierPoints'}}">
                {{#if modeEdition}}
                <input type="number" name="system.bouclier.max" value="{{system.bouclier.max}}" class="vs-petit" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.Maximum'}}" aria-label="{{localize 'GALACTICWARS.Vaisseau.Maximum'}}">
                {{else}}
                <span class="vs-petit mono" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.Maximum'}}">{{system.bouclier.max}}</span>
                {{/if}}
              </span>
            </div>
          </div>

          <div class="vs-jauge-colonne">
            <label class="vs-interrupteur">
              <span class="vs-label">{{localize 'GALACTICWARS.Sheet.BouclierActif'}}</span>
              <input type="checkbox" name="system.bouclier.actif" {{#if system.bouclier.actif}}checked{{/if}}>
              <span class="vs-interrupteur-piste"><i class="fa-solid fa-check"></i></span>
            </label>
            <label class="vs-deplacement">
              <span class="vs-label" data-tooltip="{{localize 'GALACTICWARS.Sheet.Deplacement'}}">{{localize 'GALACTICWARS.Vaisseau.Deplacement'}}</span>
              <span class="vs-deplacement-saisie">
                <i class="fa-solid fa-person-running"></i>
                <input type="number" name="system.moteur.deplacement" value="{{system.moteur.deplacement}}">
              </span>
            </label>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="vs-panneau vs-armement">
    <div class="vs-entete">
      <h2 class="vs-titre">{{localize 'GALACTICWARS.Sheet.Armement'}}</h2>
      {{#if modeEdition}}
      <button type="button" class="vs-bouton" data-action="ajouterArme"><i class="fa-solid fa-plus"></i> {{localize 'GALACTICWARS.Vaisseau.AjouterArme'}}</button>
      {{/if}}
    </div>
    {{#if ancienArmement}}
    <p class="vs-avertissement">
      <i class="fa-solid fa-triangle-exclamation"></i> {{localize 'GALACTICWARS.Vaisseau.AncienArmement' nombre=ancienArmement}}
      {{#if editable}}<button type="button" class="vs-bouton" data-action="convertirArmement">{{localize 'GALACTICWARS.Vaisseau.Convertir'}}</button>{{/if}}
    </p>
    {{/if}}
    {{#each armement as |arme|}}
    {{!-- Hors Édition, clic = carte d'attaque ; en Édition, la ligne porte le champ d'emplacement (pas d'action). --}}
    <div class="vs-arme" data-item-id="{{arme.id}}"
         {{#unless @root.modeEdition}}data-action="afficherArme" role="button" tabindex="0" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.TirerHint'}}"{{/unless}}>
      <img class="vs-arme-icone" src="{{arme.img}}" alt="">
      <span class="vs-arme-nom">
        {{arme.nom}}
        {{#if arme.competence}}<span class="vs-arme-competence">{{arme.competence}}</span>{{/if}}
      </span>
      <span class="vs-arme-stats mono">
        {{#if arme.degats}}({{arme.degats}}) · {{/if}}{{localize 'GALACTICWARS.Vaisseau.QuantiteCourte'}} {{arme.quantite}}
      </span>
      {{#if @root.modeEdition}}
      <input type="text" class="vs-arme-emplacement-saisie" data-emplacement="{{arme.id}}" value="{{arme.emplacement}}"
             placeholder="{{localize 'GALACTICWARS.Vaisseau.Emplacement'}}" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.EmplacementExemple'}}">
      <button type="button" class="vs-icone-btn editer" data-action="editerArme" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.EditerArme'}}" aria-label="{{localize 'GALACTICWARS.Vaisseau.EditerArme'}}"><i class="fa-solid fa-pen"></i></button>
      <button type="button" class="vs-icone-btn supprimer" data-action="supprimerArme" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.Supprimer'}}" aria-label="{{localize 'GALACTICWARS.Vaisseau.Supprimer'}}"><i class="fa-solid fa-trash"></i></button>
      {{else}}
      <span class="vs-arme-emplacement">{{#each arme.emplacements as |e|}}<span>{{e}}</span>{{/each}}</span>
      {{/if}}
    </div>
    {{else}}
    <p class="vs-vide">{{localize 'GALACTICWARS.Vaisseau.AucunArmement'}}</p>
    {{/each}}
  </section>

  <section class="vs-panneau vs-equipage">
    <div class="vs-entete">
      <h2 class="vs-titre">{{localize 'GALACTICWARS.Sheet.Equipage'}}</h2>
      {{#if modeEdition}}
      <button type="button" class="vs-bouton" data-action="ajouterPoste"><i class="fa-solid fa-plus"></i> {{localize 'GALACTICWARS.Vaisseau.AjouterPoste'}}</button>
      {{/if}}
    </div>
    {{#if equipage.length}}
    <div class="vs-equipage-tete">
      <span>{{localize 'GALACTICWARS.Vaisseau.Poste'}}</span>
      <span>{{localize 'GALACTICWARS.Sheet.Nom'}} {{#if editable}}<i class="fa-solid fa-circle-info vs-aide" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.AideDepot'}}"></i>{{/if}}</span>
    </div>
    {{/if}}
    {{#each equipage as |poste|}}
    <div class="vs-poste" data-index="{{poste.index}}">
      <div class="vs-poste-infos">
        <span class="vs-poste-role">{{poste.role}}{{#if (gt poste.places 1)}} <span class="vs-poste-places">({{poste.places}} {{localize 'GALACTICWARS.Vaisseau.Positions'}})</span>{{/if}}</span>
        {{#if poste.description}}<span class="vs-poste-description">{{poste.description}}</span>{{/if}}
      </div>
      <div class="vs-poste-noms">
        {{#each poste.sieges as |s|}}
        {{#if s.lie}}
        <span class="vs-membre" data-siege="{{s.siege}}" data-uuid="{{s.uuid}}">
          <button type="button" class="vs-membre-lien" data-action="ouvrirMembre" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.OuvrirMembre'}}">
            {{#if s.img}}<img src="{{s.img}}" alt="">{{else}}<i class="fa-solid fa-user-astronaut"></i>{{/if}}
            <span>{{s.nom}}</span>
          </button>
          {{#if @root.editable}}
          <button type="button" class="vs-membre-retirer" data-action="retirerMembre" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.RetirerMembre'}}" aria-label="{{localize 'GALACTICWARS.Vaisseau.RetirerMembre'}}"><i class="fa-solid fa-xmark"></i></button>
          {{/if}}
        </span>
        {{else}}
        <span class="vs-siege" data-siege="{{s.siege}}">
          <input type="text" name="system.equipage.{{poste.index}}.noms.{{s.siege}}" value="{{s.nom}}" placeholder="{{localize 'GALACTICWARS.Vaisseau.AjouterNom'}}">
        </span>
        {{/if}}
        {{/each}}
      </div>
      {{#if @root.modeEdition}}
      <div class="vs-poste-actions">
        <button type="button" class="vs-icone-btn editer" data-action="editerPoste" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.EditerPoste'}}" aria-label="{{localize 'GALACTICWARS.Vaisseau.EditerPoste'}}"><i class="fa-solid fa-pen"></i></button>
        <button type="button" class="vs-icone-btn supprimer" data-action="supprimerPoste" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.Supprimer'}}" aria-label="{{localize 'GALACTICWARS.Vaisseau.Supprimer'}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{/if}}
    </div>
    {{else}}
    <p class="vs-vide">{{localize 'GALACTICWARS.Vaisseau.AucunPoste'}}</p>
    {{/each}}
  </section>

  <section class="vs-panneau vs-amenagements">
    <div class="vs-entete">
      <h2 class="vs-titre">{{localize 'GALACTICWARS.Vaisseau.Amenagements'}}</h2>
      {{#if modeEdition}}
      <button type="button" class="vs-bouton" data-action="ajouterAmenagement"><i class="fa-solid fa-plus"></i> {{localize 'GALACTICWARS.Vaisseau.AjouterAmenagement'}}</button>
      {{/if}}
    </div>
    <div class="vs-ligne-champ">
      <span class="vs-label">{{localize 'GALACTICWARS.Vaisseau.Soute'}}</span>
      {{#if modeEdition}}<input type="text" name="system.soute" value="{{system.soute}}">
      {{else}}<span class="vs-valeur-texte">{{system.soute}}</span>{{/if}}
    </div>
    {{#if amenagements.length}}
    <div class="vs-amenagements-liste">
      {{#each amenagements as |a|}}
      <div class="vs-amenagement" data-index="{{a.index}}">
        <i class="fa-solid {{a.icone}} vs-amenagement-icone"></i>
        <div class="vs-amenagement-texte">
          <span class="vs-amenagement-nom">{{a.nom}}</span>
          {{#if a.description}}<span class="vs-amenagement-description">{{a.description}}</span>{{/if}}
        </div>
        {{#if @root.modeEdition}}
        <span class="vs-amenagement-actions">
          <button type="button" class="vs-icone-btn editer" data-action="editerAmenagement" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.EditerAmenagement'}}" aria-label="{{localize 'GALACTICWARS.Vaisseau.EditerAmenagement'}}"><i class="fa-solid fa-pen"></i></button>
          <button type="button" class="vs-icone-btn supprimer" data-action="supprimerAmenagement" data-tooltip="{{localize 'GALACTICWARS.Vaisseau.Supprimer'}}" aria-label="{{localize 'GALACTICWARS.Vaisseau.Supprimer'}}"><i class="fa-solid fa-trash"></i></button>
        </span>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{else}}
    <p class="vs-vide">{{localize 'GALACTICWARS.Vaisseau.AucunAmenagement'}}</p>
    {{/if}}
  </section>

  <section class="vs-panneau vs-description">
    <h2 class="vs-titre">{{localize 'GALACTICWARS.Vaisseau.Description'}}</h2>
    {{#if modeEdition}}
    <prose-mirror name="system.description" value="{{system.description}}" toggled>{{{descriptionEnrichie}}}</prose-mirror>
    {{else}}
    <div class="vs-description-lecture">{{{descriptionEnrichie}}}</div>
    {{/if}}
  </section>

  </div>
</div>
