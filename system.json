{
  "id": "galactic-wars",
  "title": "Galactic Wars",
  "description": "Système de jeu de rôle Star Wars maison : compétences en pourcentage, races, métiers, force, alignement Lumière/Obscurité.",
  "version": "0.9.0",
  "socket": true,
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    { "name": "Mr Banane" }
  ],
  "esmodules": ["module/galactic-wars.mjs"],
  "styles": ["styles/galactic-wars.css"],
  "languages": [
    { "lang": "fr", "name": "Français", "path": "lang/fr.json" }
  ],
  "documentTypes": {
    "Actor": {
      "personnage": { "htmlFields": [] },
      "personnage-rapide": { "htmlFields": ["description"] },
      "personnage-sith": { "htmlFields": ["description"] },
      "pnj": { "htmlFields": ["description"] },
      "vaisseau": { "htmlFields": ["description"] }
    },
    "Item": {
      "race": { "htmlFields": ["description"] },
      "metier": { "htmlFields": ["description"] },
      "talent": { "htmlFields": ["description"] },
      "arme": { "htmlFields": ["description"] },
      "armure": { "htmlFields": ["description"] },
      "pouvoir": { "htmlFields": ["description"] },
      "equipement": { "htmlFields": ["description"] },
      "ecole": { "htmlFields": ["description"] }
    }
  },
  "grid": { "distance": 1, "units": "m" },
  "primaryTokenAttribute": "pv",
  "packs": [
    { "name": "races", "label": "Races", "path": "packs/races", "type": "Item" },
    { "name": "metiers", "label": "Métiers", "path": "packs/metiers", "type": "Item" },
    { "name": "talents", "label": "Talents", "path": "packs/talents", "type": "Item" },
    { "name": "armes", "label": "Armes", "path": "packs/armes", "type": "Item" },
    { "name": "armures", "label": "Armures", "path": "packs/armures", "type": "Item" },
    { "name": "ecoles", "label": "Écoles sith", "path": "packs/ecoles", "type": "Item" },
    { "name": "pregens-sith", "label": "Pregens sith", "path": "packs/pregens-sith", "type": "Actor" },
    { "name": "vaisseaux", "label": "Vaisseaux", "path": "packs/vaisseaux", "type": "Actor" },
    { "name": "equipements", "label": "Équipements", "path": "packs/equipements", "type": "Item" }
  ]
}
